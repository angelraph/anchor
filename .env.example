# Telegram
# Create a bot with @BotFather (/newbot) and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your bot's username without the @ (used for links on the landing page).
BOT_USERNAME=

# LLM: Google Gemini
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (Google 503 "high demand").
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash

# Walrus Memory
# Sign in at https://memory.walrus.xyz and create a delegate key.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Every Telegram user gets their own namespace: <prefix><telegramUserId>
MEMWAL_NAMESPACE_PREFIX=anchor:tg:
# Telegram ids to hide from stats/check-ins (e.g. test accounts), comma-separated.
HIDDEN_USER_IDS=

# Tatum (Sui RPC + Walrus Storage)
# Free mainnet key: https://dashboard.tatum.io. Used for every Sui read/write
# (Tatum's Sui gateway speaks GraphQL) and for publishing signed reports to Walrus.
TATUM_API_KEY=
TATUM_SUI_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_API_URL=https://api.tatum.io

# Anchor's Sui wallet
# A Sui private key (suiprivkey1…), e.g. from `sui keytool generate ed25519`.
# Signs weekly reports, receives stakes (x402) and pays them back. Keep a little
# SUI in it for gas. Leave empty to run without reports, stakes and agent payments.
ANCHOR_SUI_PRIVATE_KEY=
# Public URL of this server (wallet-link and stake pages), e.g. https://anchor-production-6bb4.up.railway.app
PUBLIC_URL=
# Largest stake Anchor holds on one promise (USDC), and the x402 price agents pay per record.
STAKE_MAX_USDC=20
AGENT_PRICE_USDC=0.01

# Runtime
# Timezone used for "today", due dates and the evening check-in.
TIMEZONE=Africa/Lagos
# Hour (0-23, in TIMEZONE) when Anchor checks in about promises that are due.
CHECKIN_HOUR=19
PORT=3000
# Where small operational state lives (mount a volume here in production).
DATA_DIR=./data
